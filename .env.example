# Copy to .env.local and fill in what you need.
# Everything is optional for a local demo: with no keys the app uses 4,000
# in-memory sample clients, a demo gift card provider and a simulated Mailchimp.

# --- Campaign defaults (the admin Settings page can change these at runtime) ---
FIRM_NAME=Your Law Firm
REWARD_BRAND=Starbucks
GIFT_AMOUNT=10
BUDGET_CAP=40000
CAMPAIGN_ENDS_AT=2027-01-31
SUPPORT_EMAIL=hello@yourfirm.com

# --- Server ---
CODE_PREFIX=XMAS
TIMEZONE=America/New_York
# Public URL used in exported links and QR codes (defaults to the current host)
PUBLIC_BASE_URL=
# Demo helpers: floating demo bar, "try a code", preview pages, reset button.
# Set to false in production.
DEMO_MODE=true
# Admin password. Required when DEMO_MODE=false (the admin is locked without it).
ADMIN_PASSWORD=
# Wrong-code limit per device
RATE_LIMIT_MAX_FAILURES=10
RATE_LIMIT_WINDOW_MINUTES=15

# --- Database: Supabase (leave empty for in-memory demo data) ---
SUPABASE_URL=
# Secret key (sb_secret_...) or legacy service_role key. Server-side only.
SUPABASE_SECRET_KEY=

# --- Gift cards: Tremendous (leave empty for the demo provider) ---
TREMENDOUS_API_KEY=
# sandbox (testflight.tremendous.com) or production
TREMENDOUS_ENV=sandbox
# Starbucks product ID from the Tremendous catalog, or a campaign limited to Starbucks
TREMENDOUS_PRODUCT_ID=
TREMENDOUS_CAMPAIGN_ID=
TREMENDOUS_FUNDING_SOURCE_ID=BALANCE

# --- Mailchimp (leave empty to simulate) ---
# API key looks like abc123...-us21 (the suffix is the data center)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
